# === CONFIGURAÇÃO LLM ===
# Escolha um (descomente apenas um):

# OLLAMA (local, sem custo)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# OPENAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxx
# OPENAI_MODEL=gpt-4-turbo

# ANTHROPIC (Claude)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# GOOGLE GEMINI
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=xxxxx
# GEMINI_MODEL=gemini-pro

# === OCR ===
# Escolha um (descomente apenas um):

# LOCAL (Tesseract - precisa instalar: apt-get install tesseract-ocr)
OCR_PROVIDER=tesseract

# GOOGLE VISION (API, custo)
# OCR_PROVIDER=google_vision
# GOOGLE_VISION_API_KEY=xxxxx

# AWS TEXTRACT (API, custo)
# OCR_PROVIDER=aws_textract
# AWS_ACCESS_KEY_ID=xxxxx
# AWS_SECRET_ACCESS_KEY=xxxxx
# AWS_REGION=us-east-1

# === BANCO DE DADOS ===
DATABASE_URL=sqlite:///instance/apolices.db
SQLITE_DB_PATH=instance/apolices.db

# === APLICAÇÃO ===
ENVIRONMENT=development
DEBUG=True
PORT=8501
HOST=0.0.0.0
